# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
venv/
.venv/
.env
.env.*
.pytest_cache/
.coverage
htmlcov/
*.log

# ── Certificates & Keys ──────────────────────────────────────────────────
# Generated per-machine by utils/ssl_cert.py or developers. Never commit keys.
*.pem
*.key
*.crt
*.pfx
*.p12
server/certs/*.pem
server/certs/*.key
server/certs/cert_meta.json

# ── Pairing token ────────────────────────────────────────────────────────
# Per-machine secret generated by utils/pairing.py. Never commit it.
server/config/

# ── Node / Next.js ───────────────────────────────────────────────────────
node_modules/
.next/
# Static export consumed by the Python server — a build artifact.
frontend/out/
next-env.d.ts
*.tsbuildinfo

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
